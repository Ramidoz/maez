[Unit]
Description=Maez subscription proxy — localhost OpenAI-compatible endpoint → Claude/OpenRouter/etc adapters
Documentation=file:///home/rohit/maez/core/subscription_proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rohit
Group=rohit
WorkingDirectory=/home/rohit/maez
# Decision 26: config/.env is ordinary config only. Provider credentials are
# loaded inside Python from systemd credentials or config/secrets.local.env.
Environment=PYTHONUNBUFFERED=1
Environment=MAEZ_SUBSCRIPTION_PROXY_PORT=11438
ExecStart=/home/rohit/maez/.venv/bin/python3 -m core.subscription_proxy
Restart=always
RestartSec=5

# Localhost-only binding is enforced in code (uvicorn host=127.0.0.1).
# These hardening bits reinforce that the proxy can't be trivially
# repurposed as a local-privilege-escalation vector if misconfigured.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/rohit/maez/memory /home/rohit/maez/logs
ProtectHome=read-only
PrivateTmp=true
LockPersonality=true

# Limit ourselves — one user, one proxy, no sub-process bombs.
# Claude / Gemini CLIs will fork, so leave headroom.
LimitNOFILE=4096
TasksMax=128

StandardOutput=append:/home/rohit/maez/logs/subscription_proxy.log
StandardError=append:/home/rohit/maez/logs/subscription_proxy.log

[Install]
WantedBy=multi-user.target
