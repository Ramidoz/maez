[Unit]
Description=Maez AI Agent Daemon
Documentation=file://__MAEZ_HOME__/docs/ARCHITECTURE.md
After=network-online.target llama-server.service ollama.service
Wants=network-online.target
# Maez probes the LLM backend at startup and aborts if it can't reach
# it. The in-code probe retries with backoff (~14s window) so a brief
# llama-server restart or 503 blip self-heals. `llama-server.service`
# and `ollama.service` are both optional — if neither is installed as
# a systemd unit, Maez just waits until whichever backend is up at
# localhost. Having them in `After=` just orders startup when they
# exist, which prevents the "both start at the same second, Maez
# probes before llama-server has finished loading the model" race.

[Service]
Type=simple
User=__MAEZ_USER__
Group=__MAEZ_USER__
WorkingDirectory=__MAEZ_HOME__
Environment=PYTHONUNBUFFERED=1
Environment=MAEZ_HOME=__MAEZ_HOME__

# X11 env — only needed by the perception stack's active-window lookup
# (xdotool). Safe to leave set on headless installs; the daemon
# degrades gracefully when the X socket isn't reachable.
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/__MAEZ_UID__/gdm/Xauthority

# Decision 26: config/.env is ordinary config only and is loaded inside Python.
# Identity-bearing credentials come from systemd credentials when configured, or
# from __MAEZ_HOME__/config/secrets.local.env as the owner-local fallback.

ExecStart=__MAEZ_HOME__/.venv/bin/python3 __MAEZ_HOME__/daemon/maez_daemon.py
Restart=on-failure
RestartSec=10

# Conservative hardening — the daemon needs the repo writable (logs,
# memory/*.db) and the /tmp scratchpad. Everything else is read-only
# or off-limits.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__MAEZ_HOME__/memory __MAEZ_HOME__/logs __MAEZ_HOME__/config
# Mark config writable because soul.local.md is appended to at runtime.

StandardOutput=append:__MAEZ_HOME__/logs/maez.log
StandardError=append:__MAEZ_HOME__/logs/maez.log

[Install]
WantedBy=multi-user.target
