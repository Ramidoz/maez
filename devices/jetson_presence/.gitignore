# Runtime artifacts that must stay Jetson-local (never committed):
.env*
secrets*
runtime*
state/
logs/
*.token
token
*.key
*.pem
*.secret
__pycache__/
*.pyc

# B1a models: the root .gitignore ignores any `models/`, which would also hide this
# device's TRACKED model manifest. Re-include the dir, then keep the heavy build
# artifacts Jetson-local (never committed):
!models/
models/*.onnx
models/*.engine
models/*.plan
models/*.npz
models/*.npy
models/*.zip
