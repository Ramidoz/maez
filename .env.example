# Maez — example environment file
#
# Copy to config/.env and edit in place. config/.env is gitignored.
#
#   cp .env.example config/.env
#   $EDITOR config/.env
#
# Every value below is optional. Empty or missing variables fall back
# to safe defaults documented in:
#   - core/paths.py      (install layout)
#   - core/identity.py   (owner/person identity)
#   - core/model_config.py + core/llm_client.py (models)
#   - core/subscription_proxy/  (API keys)
#
# Nothing in this file is required to run Maez locally with llama.cpp
# and a config/identity.yaml. The knobs below are for overriding
# defaults without editing YAML.


# ─────────────────────────────────────────────────────────────────────
#  Install layout (core/paths.py)
# ─────────────────────────────────────────────────────────────────────

# Root of the Maez install. Defaults to /home/rohit/maez today; will
# default to the repo root once Phase 2 completes. Overriding this is
# the single lever for relocating everything.
# MAEZ_HOME=/home/yourname/maez

# Split points — useful if data lives on a different disk than code.
# MAEZ_CONFIG=$MAEZ_HOME/config
# MAEZ_DATA=$MAEZ_HOME
# MAEZ_CACHE=$MAEZ_HOME/.cache


# ─────────────────────────────────────────────────────────────────────
#  Owner identity (core/identity.py; win over config/identity.yaml)
# ─────────────────────────────────────────────────────────────────────

# Display name Maez addresses you by.
# MAEZ_OWNER_NAME=Friend

# Stable per-session identifier. Distinct from display_name.
# MAEZ_OWNER_USER_ID=owner

# GitHub/GitLab handle. Used by self_dev + any future PR-posting code.
# Empty string opts out of posting to your account.
# MAEZ_OWNER_GIT_HANDLE=

# Numeric Telegram user ID the daemon DMs. Empty to disable the
# Telegram push surface. MAEZ_TELEGRAM_USER_ID is also accepted as an
# alias for backwards compatibility.
# MAEZ_OWNER_TELEGRAM_ID=

# Short hardware/OS description. Never load-bearing; surfaces in logs.
# MAEZ_MACHINE_PROFILE=MacBook Pro M2 + 32GB RAM, macOS 14

# Location hints. These override the coords in identity.yaml.
# MAEZ_HOME_LAT=
# MAEZ_HOME_LON=
# MAEZ_OWNER_HOME_PLACE=
# MAEZ_OWNER_TIMEZONE=UTC
# MAEZ_LOCATION_FRESHNESS_HOURS=24


# ─────────────────────────────────────────────────────────────────────
#  Model selection (core/model_config.py + core/llm_client.py)
# ─────────────────────────────────────────────────────────────────────

# Primary generation model served by local llama-server.
# MAEZ_PRIMARY_MODEL=
# MAEZ_LLAMACPP_MODEL=        # legacy alias for PRIMARY_MODEL

# Judge + audit + summarizer models (small local judge).
# MAEZ_JUDGE_MODEL=
# MAEZ_AUDIT_MODEL=

# Timeouts (seconds) — tune for GPU speed.
# MAEZ_JUDGE_TIMEOUT_S=
# MAEZ_SUMMARIZER_TIMEOUT_S=

# Self-mod dialog model overrides.
# MAEZ_SELF_MOD_CLASSIFIER_MODEL=
# MAEZ_SELF_MOD_OPENER_MODEL=
# MAEZ_SELF_MOD_RESPONDER_MODEL=


# ─────────────────────────────────────────────────────────────────────
#  External API keys (subscription proxy + optional cloud routing)
# ─────────────────────────────────────────────────────────────────────

# If you want Maez to be able to route hard tasks to Claude via
# Anthropic's API. Keep blank to stay fully local.
# ANTHROPIC_API_KEY=

# Other optional cloud routes (all opt-in; see core/subscription_proxy/).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=

# Subscription proxy local port. Leave default unless the port is busy.
# MAEZ_SUBSCRIPTION_PROXY_PORT=11438

# Default routing models per adapter (override only if you know why).
# MAEZ_CLAUDE_DEFAULT_MODEL=
# MAEZ_OPENAI_DEFAULT_MODEL=
# MAEZ_XAI_DEFAULT_MODEL=
# MAEZ_WORKSHOP_DEFAULT_MODEL=

# Gemini CLI integration — path to the gemini binary and timeout.
# MAEZ_GEMINI_BIN=gemini
# MAEZ_GEMINI_TIMEOUT_S=


# ─────────────────────────────────────────────────────────────────────
#  Surfaces (Telegram, iPhone ingest, workshop)
# ─────────────────────────────────────────────────────────────────────

# Telegram bot token. Without this the daemon runs without Telegram.
# MAEZ_TELEGRAM_TOKEN=

# If set, iOS Shortcuts can POST signals to /api/iphone/ingest.
# Any random hard-to-guess string will do.
# MAEZ_IPHONE_INGEST_TOKEN=

# Workshop (in-cockpit coding) tuning.
# MAEZ_WORKSHOP_CONTEXT_TURNS=


# ─────────────────────────────────────────────────────────────────────
#  Self-dev loop (core/self_dev*.py)
# ─────────────────────────────────────────────────────────────────────

# Per-hour/per-day budget floors that stop the hook from consuming
# your Claude subscription. Raise only if your subscription has more
# headroom than the defaults assume.
# MAEZ_SELF_DEV_HOURLY_FLOOR=3
# MAEZ_SELF_DEV_DAILY_FLOOR=5
# MAEZ_SELF_DEV_MAX_AUTO_DIFF_CHARS=80000
# MAEZ_SELF_DEV_MODEL=


# ─────────────────────────────────────────────────────────────────────
#  Other knobs (most users won't need these)
# ─────────────────────────────────────────────────────────────────────

# Override where private_thoughts.db lives.
# MAEZ_PRIVATE_THOUGHTS_PATH=

# Tool loop caps.
# MAEZ_TOOL_TIMEOUT_SEC=
# MAEZ_TOOL_OUTPUT_MAX=

# Summary cap.
# MAEZ_SUMMARY_MAX_TOKENS=

# LoRA adapter path (if using a fine-tuned LoRA over the base model).
# MAEZ_LORA_PATH=

# Disable the Phase-2 surface layer (emergency fallback to legacy).
# MAEZ_DISABLE_SURFACE_V2=

# Turn semantic-audit on or off explicitly (default is on).
# MAEZ_SEMANTIC_AUDIT=

# Self-dev scheduled-review glob skiplist.
# MAEZ_SELF_DEV_SCHEDULED_SKIP_GLOBS=

# ─────────────────────────────────────────────────────────────────────
#  Evolution / proactive engagement (post-2026-04-29 audit slices)
# ─────────────────────────────────────────────────────────────────────

# Enable working-self goal hierarchy assembly (Slice 1 of post-audit
# work). When set, daemon assembles a Conway-2000 working-self goal
# hierarchy each turn and biases lived-recall retrieval toward
# goal-aligned memories. Default OFF (opt-in until probe-validated).
# MAEZ_WORKING_SELF=0

# Enable wondering-pursuit proactive surfacing (Slice 2). When set,
# daemon evaluates open wonderings each turn and may append a
# proactive utterance to replies if goal-aligned, not in a
# vulnerable conversational register, and within frequency budget
# (max 2 surfaces per 24h sliding window). Also gated by the
# per-user policy `proactive_messages` in config/identity.yaml.
# Default OFF.
# MAEZ_WONDERING_PURSUIT=0

# Wondering-pursuit tunable constants (Slice 2). Sourced from
# ``core.evolution.wondering_pursuit`` module-level constants;
# documented here so operators know they exist. Override via code
# edit; future cockpit-data-driven tuning may surface env knobs.
#
#   PURSUIT_SCORE_THRESHOLD          = 0.6
#       Composite score threshold above which a wondering surfaces.
#       Conservative starting heuristic; lower → more surfaces.
#
#   PURSUIT_FREQUENCY_BUDGET_HOURS   = 12.0
#       Minimum hours between proactive surfacings (across all
#       wonderings). 12 = at most 2 surfaces per 24h.
#
#   RECENCY_HALF_LIFE_HOURS          = 6.0
#       Half-life for the recency axis AND the probe-loop cooldown
#       window (single source-of-truth shared across both channels).
