# Birth-phase tracking — per-instance runtime state. See
# core/memory/birth.py. Tracking this in git would cause fire_birth()
# to produce a dirty tree and risk accidentally committing another
# instance's lived state on top of the owner's. Untracked 2026-04-23.
memory/self_awareness.json

# External vendored tooling checked out as a sibling repo; not ours.
/superpowers/

# Next.js build artifacts + dependencies (regenerated by build)
web/.next/
web/node_modules/
web/out/
*.tsbuildinfo

# Training data stays local (potentially publishable separately on HF)
training/data/
training/proposals/*.md
!training/proposals/reasoning_sft_proposal.md

# Stray session status logs (runtime artifact)
logs/iphone_shortcuts_status.md

# Runtime evolution candidates DB — schema regenerates on startup
evolution/*.db

# Obsidian: ignore per-window state + transient cache,
# keep the shared config (graph colors, plugin settings, hotkeys)
# so the vault behaves consistently across machines.
docs/.obsidian/workspace*
docs/.obsidian/cache
docs/.obsidian/app.json

# LongMemEval dataset files (downloaded on demand; large; not part of repo).
data/longmemeval/

# Per-run benchmark outputs: ignore raw JSON (large + per-machine),
# but commit md / txt summaries and sample-ID lists by name.
docs/eval/runs/*.json

# Brain benchmark raw answer/evidence dumps are quarantined local artifacts.
logs/brain_bench_debug/

# Owner-approved frozen screen frames, human labels, raw transcripts, and
# bake-off diagnostics/receipts are private local bench artifacts (Vision S3).
/local/vision_bench/
.claude/

# Tooling / agent-harness / IDE dirs — not part of Maez's body, never committed
.vscode/
.agents/
