# Per-user config (shipped as *.template.yaml; personalized copy stays local)
config/identity.yaml
config/reddit_subs.yaml

# SOUL layering — soul.base.md ships (universal template).
# soul.local.md is per-user accumulation; soul.md is the regenerated
# concatenation written by core/soul_loader.py for backward-compat.
config/soul.local.md
config/soul.md

# Owner-curated entity alias seed — Step 5g. Local file holds real
# names; only the example fixture (docs/entity_aliases.example.yaml)
# is committed.
config/entity_aliases.local.yaml

# Owner-curated semantic entity mappings — Step 5n. Local file
# holds owner-language phrase→entity bridges; only the example
# fixture (docs/entity_semantics.example.yaml) is committed.
config/entity_semantics.local.yaml

# Owner-local S1b private-thoughts kill-switch/runtime tuning.
config/private_thoughts_s1b.local.json
config/private_thoughts_s1b.local.json.*

# Owner-local Telegram draft-presence runtime tuning.
config/telegram_draft_presence.local.json
config/telegram_draft_presence.local.json.*

