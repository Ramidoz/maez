.venv/
node_modules/
__pycache__/
*.pyc
config/.env
config/token.json
config/credentials.json
memory/db/
memory/*.db
memory/chroma/
# Belt-and-suspenders: after Phase 3 there is also a core/memory/
# subpackage. A module-path regression could cause a runtime DB to
# land there; ignore it proactively so it never accidentally gets
# committed.
core/memory/*.db
core/memory/*.json
models/
logs/*
!logs/snapshots/
backups/
staging/
evolution/backups/
evolution/pending_evolution.json
daemon/maez.pid
daemon/pending_actions.json
daemon/last_shutdown
daemon/builder_mode_current.txt
daemon/builder_mode_hwm.txt
*.bak
*.bak2
*.bak-*
*.bak.*
*.orig
*.db-shm
*.db-wal
*.db-journal
/tmp/
PROGRESS.md
training/.venv/
training/runs/
training/datasets/
training/unsloth_compiled_cache/
*.safetensors
*.gguf

# Per-user config (shipped as *.template.yaml; personalized copy stays local)
config/identity.yaml
config/reddit_subs.yaml

# SOUL layering — soul.base.md ships (universal template).
# soul.local.md is per-user accumulation; soul.md is the regenerated
# concatenation written by core/soul_loader.py for backward-compat.
config/soul.local.md
config/soul.md

# Working docs, intimate narratives, in-progress follow-ups — stay local
docs/REBUILD_PLAN_*.md
docs/TASK_TREEMAP.md
docs/birth_book/
docs/followups/
docs/maez_facing/

# Runtime state (grows on its own; not source code)
memory/continuity_capsule.json
memory/continuity_archive/
memory/fast_reply_audit.jsonl
memory/site_analytics.jsonl
memory/last_briefing.txt
memory/perception_cache.json
memory/last_consolidation.txt
memory/last_pursuit.json
daemon/last_pursuit.json
memory/*.tmp
# Birth-phase tracking — per-instance runtime state. See
# core/memory/birth.py. Tracking this in git would cause fire_birth()
# to produce a dirty tree and risk accidentally committing another
# instance's lived state on top of the owner's. Untracked 2026-04-23.
memory/self_awareness.json

# External vendored tooling checked out as a sibling repo; not ours.
/superpowers/

# Next.js build artifacts + dependencies (regenerated by build)
web/.next/
web/node_modules/
web/out/
*.tsbuildinfo

# Training data stays local (potentially publishable separately on HF)
training/data/
training/proposals/*.md
!training/proposals/reasoning_sft_proposal.md

# Stray session status logs (runtime artifact)
logs/iphone_shortcuts_status.md

# Runtime evolution candidates DB — schema regenerates on startup
evolution/*.db

# Obsidian: ignore per-window state + transient cache,
# keep the shared config (graph colors, plugin settings, hotkeys)
# so the vault behaves consistently across machines.
docs/.obsidian/workspace*
docs/.obsidian/cache
docs/.obsidian/app.json

# LongMemEval dataset files (downloaded on demand; large; not part of repo).
data/longmemeval/

# Per-run benchmark outputs; commit summary docs by name, not the raw JSON.
docs/eval/runs/
